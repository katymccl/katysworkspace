# Copy to .env.local for local development (it's gitignored), and set the same variables in
# Vercel → Project → Settings → Environment Variables for production.
# These are server-only. Never prefix them with VITE_, or Vite will bundle them into the browser.

# Required for "Interpret with AI". Without it, the button shows a "not set up" message.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-haiku-5-5 (cheapest). For richer descriptions: claude-sonnet-5-5.
SEMA_AI_MODEL=
